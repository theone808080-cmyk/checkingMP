# Local PostgreSQL database for the pilot.
DATABASE_URL=
# Port of the local dashboard.
PORT=8000

# Local LM Studio OpenAI-compatible server (load a model before processing).
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=120
LM_STUDIO_BATCH_SIZE=10

# Optional local HTTPS worker mode: set both values privately or leave both unset.
WORKER_API_URL=
WORKER_TOKEN=
# Web-only credentials: set privately when starting web.
WEB_BASIC_USER=
WEB_BASIC_PASSWORD=

