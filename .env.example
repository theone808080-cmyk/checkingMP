# PostgreSQL connection string. Set this locally or in the Coolify runtime environment.
DATABASE_URL=

# Optional web settings.
PORT=8000
WEB_BASIC_USER=
WEB_BASIC_PASSWORD=

# Configure privately at runtime. Set all three to enable Telegram notifications.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
RADAR_MINIAPP_URL=

# OpenRouter is called directly by the server-side processing command.
# Enter the real API key only in Coolify at runtime; never commit it here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-nano
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_BATCH_SIZE=10
OPENROUTER_MAX_TOKENS=2500

# Watchdog service. Add these only to its separate Coolify application.
WATCHDOG_DATABASE_URL=
RADAR_HEALTH_URL=
COOLIFY_API_URL=
COOLIFY_APPLICATION_UUID=
COOLIFY_API_TOKEN=
WATCHDOG_STATE_PATH=/data/watchdog-fallback.json
WATCHDOG_HEARTBEAT_PATH=/data/watchdog-heartbeat
WATCHDOG_MODE=

# Optional free-credit search. Keep Exa account overage disabled.
EXA_API_KEY=
